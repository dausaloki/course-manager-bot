# ============ Telegram ============
# Token from @BotFather (NEVER commit the real value)
TELEGRAM_BOT_TOKEN=
# Destination channel/group id (e.g. -1001234567890) where files are uploaded
TELEGRAM_CHAT_ID=
# Your numeric Telegram user id (use /id command of this bot or @userinfobot)
ADMIN_USER_ID=

# ============ Source application (OFFICIAL / AUTHORIZED API ONLY) ============
# Base URL of the official, documented API you are authorized to use
APP_API_BASE_URL=
# OAuth / API credentials issued to you by the application vendor
APP_CLIENT_ID=
APP_CLIENT_SECRET=

# ============ Database ============
DATABASE_URL=sqlite:///course_manager.db

# ============ Behaviour ============
# true = fully simulated source API + simulated uploads (safe testing)
TEST_MODE=true
LOG_LEVEL=INFO
# First index number that will be assigned to uploads
INDEX_START=1
